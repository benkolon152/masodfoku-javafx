<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" minHeight="600.0" minWidth="800.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.masodfokujavafx.masodfokController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="Quadratic equation solver">
         <font>
            <Font size="39.0" />
         </font>
      </Label>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <TextField id="textfield_a" fx:id="textfield_a" alignment="CENTER_RIGHT" promptText="a">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </TextField>
            <Label alignment="CENTER_RIGHT" contentDisplay="CENTER" text="x² +">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Label>
            <TextField id="textfield_b" fx:id="textfield_b" alignment="CENTER" promptText="b">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </TextField>
            <Label text="* x +">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Label>
            <TextField id="textfield_c" fx:id="textfield_c" promptText="c">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </TextField>
            <Label text="= 0">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
      <Button id="button_solve" fx:id="button_solve" mnemonicParsing="false" onAction="#onSolveButtonClick" text="Solve quadratic equation" />
      <ListView id="listwiev_sol" fx:id="listwiev_sol" editable="true" prefHeight="200.0" prefWidth="200.0" />
   </children>
</VBox>
